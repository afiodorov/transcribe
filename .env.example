# Provider keys: set at least one; the model dropdown shows only the ones set.
# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=
# Gemini (https://aistudio.google.com/apikey). Use a key from a project with
# billing on: Google trains on free-tier API data.
GEMINI_API_KEY=
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Secret in the shareable link https://<host>/s/<ACCESS_TOKEN>; at least 20 chars.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Changing it revokes every browser that already opened the old link.
ACCESS_TOKEN=
# Public base URL, used by `make link`
PUBLIC_URL=http://localhost:8000
# Optional
DEFAULT_LANGUAGE=es
MAX_UPLOAD_MB=500
# Testing only: split every recording into chunks of this many seconds
# CHUNK_SECONDS=60
